@page "/suggerimenti"
@using System.Text.Json
@using System.IO
@inject IWebHostEnvironment Env
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Elevation="1" Class="pa-0">
        @* Configurazione Blu:
           - SliderColor="Color.Info" per la linea blu sotto il tab attivo
           - ActiveTabClass per il testo in grassetto blu
        *@
        <MudTabs Elevation="0"
                 Rounded="false"
                 ApplyEffectsToContainer="true"
                 PanelClass="pa-6 mt-2"
                 Color="Color.Default"
                 SliderColor="Color.Info"
                 ActiveTabClass="mud-info-text mud-tab-active-bold">

            @* --- TAB 1: INVIO / MODIFICA --- *@
            <MudTabPanel Text="@(isEditing ? $"MODIFICA IDEA (1)" : $"INVIA IDEA (1)")">
                <MudPaper Elevation="0">
                    <MudStack Spacing="4">
                        @if (isEditing)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true">Modalità modifica attiva</MudAlert>
                        }

                        <MudTextField @bind-Value="nome" Label="Nome" Variant="Variant.Outlined" FullWidth="true" />
                        <MudTextField @bind-Value="messaggio" Label="Descrivi il suggerimento" Variant="Variant.Outlined" Lines="5" FullWidth="true" />

                        <div class="d-flex gap-4">
                            <MudButton Variant="Variant.Filled" Color="isEditing? Color.Warning: Color.Primary" Size="Size.Large" OnClick="SalvaSuggerimento" FullWidth="true" DisableElevation="true">
                                @(isEditing ? "AGGIORNA IDEA" : "SALVA SUGGERIMENTO")
                            </MudButton>
                            @if (isEditing)
                            {
                                <MudButton Variant="Variant.Outlined" OnClick="AnnullaModifica">ANNULLA</MudButton>
                            }
                        </div>
                    </MudStack>
                </MudPaper>
            </MudTabPanel>

            @* --- TAB 2: TABELLA --- *@
            <MudTabPanel Text="@($"LISTA IDEE ({listaSuggerimenti.Count})")">
                @if (listaSuggerimenti.Count == 0)
                {
                    <MudText Color="Color.Error" Class="mt-4">Nessun task disponibile.</MudText>
                }
                else
                {
                    <MudTable Items="@listaSuggerimenti" Hover="true" Dense="true" Height="400px" FixedHeader="true" Elevation="0" Class="mt-4">
                        <HeaderContent>
                            <MudTh>DATA</MudTh>
                            <MudTh>AUTORE</MudTh>
                            <MudTh>SUGGERIMENTO</MudTh>
                            <MudTh Style="text-align:right">AZIONI</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Data">@context.Data.ToShortDateString()</MudTd>
                            <MudTd DataLabel="Autore"><b>@context.Nome</b></MudTd>
                            <MudTd DataLabel="Suggerimento">@context.Messaggio</MudTd>
                            <MudTd Style="text-align:right">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => PreparaModifica(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => EliminaRiga(context.Id))" />
                                <MudIconButton Size="Size.Small" Icon=@Icons.Material.Filled.FolderOpen />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
</MudContainer>

<style>
    .mud-tab-active-bold {
        font-weight: 700 !important;
        color: var(--mud-palette-info) !important;
    }

    .mud-tab {
        justify-content: flex-start !important;
        padding: 16 mud-tab-active-boldpx 24px !important;
        text-transform: uppercase !important;
        letter-spacing: 1px;
    }
</style>

@code {
    private string nome, messaggio, editId;
    private bool isEditing = false;
    private List<SuggerimentoItem> listaSuggerimenti = new();

    public class SuggerimentoItem
    {
        public string Id { get; set; }
        public string Nome { get; set; }
        public string Messaggio { get; set; }
        public DateTime Data { get; set; }
    }

    protected override async Task OnInitializedAsync() => await CaricaDati();

    private async Task CaricaDati()
    {
        var path = Path.Combine(Env.ContentRootPath, "Data", "suggerimenti", "suggerimenti_history.json");
        if (File.Exists(path))
        {
            var json = await File.ReadAllTextAsync(path);
            listaSuggerimenti = JsonSerializer.Deserialize<List<SuggerimentoItem>>(json) ?? new();
            listaSuggerimenti = listaSuggerimenti.OrderByDescending(f => f.Data).ToList();
        }
    }

    private async Task SalvaSuggerimento()
    {
        if (string.IsNullOrWhiteSpace(nome)) return;
        if (isEditing)
        {
            var item = listaSuggerimenti.FirstOrDefault(x => x.Id == editId);
            if (item != null) { item.Nome = nome; item.Messaggio = messaggio; }
            isEditing = false;
        }
        else
        {
            listaSuggerimenti.Insert(0, new SuggerimentoItem { Id = Guid.NewGuid().ToString(), Nome = nome, Messaggio = messaggio, Data = DateTime.Now });
        }
        await SalvaSuFile();
        nome = ""; messaggio = "";
        Snackbar.Add("Salvato!", Severity.Info);
    }

    private void PreparaModifica(SuggerimentoItem item)
    {
        nome = item.Nome; messaggio = item.Messaggio; editId = item.Id; isEditing = true;
        Snackbar.Add("Modifica pronta nel primo Tab", Severity.Info);
    }

    private async Task EliminaRiga(string id)
    {
        listaSuggerimenti.RemoveAll(x => x.Id == id);
        await SalvaSuFile();
        Snackbar.Add("Eliminato", Severity.Error);
    }

    private async Task SalvaSuFile()
    {
        var folder = Path.Combine(Env.ContentRootPath, "Data", "suggerimenti");
        if (!Directory.Exists(folder)) Directory.CreateDirectory(folder);
        await File.WriteAllTextAsync(Path.Combine(folder, "suggerimenti_history.json"), JsonSerializer.Serialize(listaSuggerimenti, new JsonSerializerOptions { WriteIndented = true }));
    }

    private void AnnullaModifica() { isEditing = false; nome = ""; messaggio = ""; }
}