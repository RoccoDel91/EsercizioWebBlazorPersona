@page "/suggerimenti"
@using System.Text.Json
@using System.IO
@inject IWebHostEnvironment Env
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudStack Spacing="6">

        @* SEZIONE 1: INVIO SUGGERIMENTO *@
        <MudPaper Elevation="4" Class="pa-6">
            <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Color="Color.Primary" Class="mr-2" />
                Inviaci un Suggerimento 💡
            </MudText>

            @if (!formInviato)
            {
                <MudGrid>
                    <MudItem xs="12" sm="12">
                        <MudTextField @bind-Value="nomeUtente" Label="Il tuo Nome" Variant="Variant.Outlined" FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="messaggio" Label="Descrivi il tuo suggerimento" Variant="Variant.Outlined" Lines="4" FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" Class="d-flex justify-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="SalvaInJson" Class="px-12">
                            Invia Suggerimento
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Action="@(new Action(ResetForm))" ActionText="Invia un altro">
                    Grazie @nomePrecedente! Il tuo suggerimento è stato registrato con successo.
                </MudAlert>
            }
        </MudPaper>

        @* SEZIONE 2: BACHECA SUGGERIMENTI *@
        <MudPaper Elevation="2" Class="pa-6">
            <MudText Typo="Typo.h5" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
                Suggerimenti Ricevuti
            </MudText>

            <MudTable Items="@listaSuggerimenti" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@loading" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Data</MudTh>
                    <MudTh>Nome</MudTh>
                    <MudTh>Suggerimento</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="ID"><MudChip Size="Size.Small" Variant="Variant.Text">@context.Id</MudChip></MudTd>
                    <MudTd DataLabel="Data">@context.Data.ToShortDateString()</MudTd>
                    <MudTd DataLabel="Nome"><b>@context.Nome</b></MudTd>
                    <MudTd DataLabel="Suggerimento">@context.Messaggio</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>Nessun suggerimento presente nella bacheca.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

    </MudStack>
</MudContainer>

@code {
    private string nomeUtente;
    private string messaggio;
    private bool formInviato = false;
    private bool loading = true;
    private string nomePrecedente;
    private List<SuggerimentoItem> listaSuggerimenti = new();

    public class SuggerimentoItem
    {
        public string Id { get; set; }
        public string Nome { get; set; }
        public string Messaggio { get; set; }
        public DateTime Data { get; set; }
    }

    private void ResetForm()
    {
        nomeUtente = "";
        messaggio = "";
        formInviato = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await CaricaSuggerimenti();
    }

    private async Task CaricaSuggerimenti()
    {
        loading = true;
        try
        {
            var filePath = Path.Combine(Env.ContentRootPath, "Data", "feedbacks", "feedback_history.json");
            if (File.Exists(filePath))
            {
                string json = await File.ReadAllTextAsync(filePath);
                listaSuggerimenti = JsonSerializer.Deserialize<List<SuggerimentoItem>>(json) ?? new();
                listaSuggerimenti = listaSuggerimenti.OrderByDescending(f => f.Data).ToList();
            }
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { loading = false; }
    }

    private async Task SalvaInJson()
    {
        if (string.IsNullOrWhiteSpace(nomeUtente))
        {
            Snackbar.Add("Il nome è obbligatorio!", Severity.Warning);
            return;
        }

        try
        {
            var folderPath = Path.Combine(Env.ContentRootPath, "Data", "feedbacks");
            var filePath = Path.Combine(folderPath, "feedback_history.json");

            if (!Directory.Exists(folderPath)) Directory.CreateDirectory(folderPath);

            nomePrecedente = nomeUtente;

            var nuovo = new SuggerimentoItem
            {
                Id = Guid.NewGuid().ToString().Substring(0, 8),
                Nome = nomeUtente,
                Messaggio = messaggio,
                Data = DateTime.Now
            };

            List<SuggerimentoItem> listaAttuale = new();
            if (File.Exists(filePath))
            {
                string jsonVecchio = await File.ReadAllTextAsync(filePath);
                if (!string.IsNullOrWhiteSpace(jsonVecchio))
                {
                    listaAttuale = JsonSerializer.Deserialize<List<SuggerimentoItem>>(jsonVecchio) ?? new();
                }
            }

            listaAttuale.Insert(0, nuovo);
            var opzioni = new JsonSerializerOptions { WriteIndented = true };
            await File.WriteAllTextAsync(filePath, JsonSerializer.Serialize(listaAttuale, opzioni));

            listaSuggerimenti = listaAttuale.OrderByDescending(f => f.Data).ToList();
            formInviato = true;
            Snackbar.Add("Suggerimento inviato!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
        }
    }
}